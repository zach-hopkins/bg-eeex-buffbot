---------------------
-- BuffBot UI Menu --
---------------------

-- ==========================================================
-- Companion menu for the actionbar button (pushed/popped
-- alongside WORLD_ACTIONBAR via onOpen/onClose hooks)
-- ==========================================================
menu
{
	name "BUFFBOT_ACTIONBAR"
	ignoreesc

	button
	{
		name "bbHudButton"
        enabled "BfBot.UI._ActionbarVisible()"
        action    "BfBot.UI.Toggle()"
        actionAlt "BfBot.UI._ToggleQuickMenu()"
        tooltip "BuffBot: left-click to edit; right-click to cast a preset"
		bam       "BFBOTAB"
		sequence  0
		frame lua "buffbot_btnFrame"
		scaleToClip
		area 4 4 48 48
	}

	-- Safety net tick: runs every frame, rate-limited internally to ~2s.
	-- Removes orphaned BFBTCH cheat buffs when exec engine not running.
	label
	{
		enabled "BfBot.Exec._SafetyTick()"
		area 0 0 0 0
	}
	label
	{
		enabled "BfBot.Rest.Tick()"
		area 0 0 0 0
	}
}

-- ==========================================================
-- Main configuration panel
-- ==========================================================
-- Recipient-first party planner (single-player beta).
-- Dashboard content and allocations are prepared in BfBotPUI.lua.
menu
{
	name "BUFFBOT_PARTY"
	ignoreesc
	onopen "BfBot.PartyUI.OnOpen()"
	text
	{
		name "bpDismiss"
		action "BfBot.PartyUI.Close()"
		rectangle 1
		rectangle opacity 140
		on escape
		area 0 0 99999 99999
	}
	label
	{
		name "bpBg"
		enabled "true"
		mosaic "BFBOTBG"
		area 0 0 1000 600
	}
	label
	{
		name "bpTick"
		enabled "BfBot.PartyUI.Tick()"
		area 0 0 0 0
	}
	button
	{
		name "bpDashboardTab"
		enabled "true"
		action "BfBot.PartyUI.SetView('dashboard')"
		text lua "BfBot.Plan.Text('Party Buffs')"
		text style "bb_button"
		bam "GUIOSTUL"
		scaleToClip
		frame lua "BfBot.PartyUI.view == 'dashboard' and 1 or 0"
		area 0 0 100 28
	}
	button
	{
		name "bpSummaryTab"
		enabled "true"
		action "BfBot.PartyUI.SetView('summary')"
		text lua "BfBot.Plan.Text('Summary')"
		text style "bb_button"
		bam "GUIOSTUL"
		scaleToClip
		frame lua "BfBot.PartyUI.view == 'summary' and 1 or 0"
		area 0 0 100 28
	}
	button
	{
		name "bpOrderTab"
		enabled "true"
		action "BfBot.PartyUI.SetView('order')"
		text lua "BfBot.Plan.Text('Order')"
		text style "bb_button"
		bam "GUIOSTUL"
		scaleToClip
		frame lua "BfBot.PartyUI.view == 'order' and 1 or 0"
		area 0 0 100 28
	}
	button
	{
		name "bpPreset"
		enabled "true"
		action "BfBot.PartyUI.OpenChoices('presets')"
		text lua "bbPartyName .. '  v'"
		text style "bb_button"
		bam "GUIOSTUL"
		scaleToClip
		area 0 0 100 28
	}
	button
	{
		name "bpNew"
		enabled "true"
		action "BfBot.PartyUI.CreatePreset()"
		text lua "'+'"
		text style "bb_button"
		bam "GUIOSTUL"
		scaleToClip
		tooltip lua "BfBot.Plan.Text('New preset')"
		area 0 0 100 28
	}
	button
	{
		name "bpSettings"
		enabled "true"
		action "BfBot.PartyUI.OpenChoices('settings')"
		text lua "'...'"
		text style "bb_button"
		bam "GUIOSTUL"
		scaleToClip
		tooltip lua "BfBot.Plan.Text('Options')"
		area 0 0 100 28
	}
	button
	{
		name "bpClose"
		enabled "true"
		action "BfBot.PartyUI.Close()"
		text lua "'X'"
		text style "bb_button"
		bam "GUIOSTUL"
		scaleToClip
		tooltip lua "BfBot.Plan.Text('Close')"
		area 0 0 100 28
	}
	label
	{
		name "bpSearchFrame"
		enabled "BfBot.PartyUI.IsDashboard()"
		rectangle 5
		rectangle opacity 255
		area 0 0 100 28
	}
	label
	{
		name "bpSearchBg"
		enabled "BfBot.PartyUI.IsDashboard()"
		rectangle 1
		rectangle opacity 45
		area 0 0 100 28
	}
	label
	{
		name "bpSearchHint"
		enabled "BfBot.PartyUI.IsDashboard() and bbPartyQuery == ''"
		text lua "BfBot.Plan.Text('Search')"
		text style "bb_normal_parchment"
		text color lua "{38,32,26}"
		text align left center
		area 0 0 100 28
	}
	edit
	{
		name "bpSearch"
		enabled "BfBot.PartyUI.IsDashboard()"
		var "bbPartyQuery"
		action "return 1"
		text style "bb_edit"
		text color lua "{38,32,26}"
		maxlines 1
		area 0 0 100 28
	}
	button
	{
		name "bpSearchClear"
		enabled "BfBot.PartyUI.IsDashboard() and bbPartyQuery ~= ''"
		action "BfBot.PartyUI.ClearSearch()"
		text lua "'X'"
		text style "bb_button"
		bam "GUIOSTUL"
		scaleToClip
		area 0 0 100 28
	}
	label
	{
		name "bpHeadIcon"
		enabled "BfBot.PartyUI.view == 'dashboard'"
		text lua "BfBot.Plan.Text('Icon')"
		text style "bb_normal_parchment"
		text color lua "{38,32,26}"
		text align left center
		area 0 0 100 28
	}
	button
