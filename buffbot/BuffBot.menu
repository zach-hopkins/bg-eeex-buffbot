	label
	{
		name "bpRenameTop"
		rectangle 5
		rectangle opacity 255
		area 0 0 100 28
	}
	label
	{
		name "bpRenameBottom"
		rectangle 5
		rectangle opacity 255
		area 0 0 100 28
	}
	label
	{
		name "bpRenameLeft"
		rectangle 5
		rectangle opacity 255
		area 0 0 100 28
	}
	label
	{
		name "bpRenameRight"
		rectangle 5
		rectangle opacity 255
		area 0 0 100 28
	}
	label
	{
		name "bpRenameBg"
		mosaic "BFBOTBG"
		area 0 0 100 28
	}
	edit
	{
		name "bpName"
		var "bbPartyName"
		action "return 1"
		text style "bb_edit"
		text color lua "{38,32,26}"
		maxlines 1
		area 0 0 100 28
	}
	button
	{
		name "bpSaveName"
		enabled "true"
		action "BfBot.PartyUI.SaveName()"
		text lua "BfBot.Plan.Text('Save')"
		text style "bb_button"
		bam "GUIOSTUL"
		scaleToClip
		area 0 0 100 28
	}
	button
	{
		name "bpCancelName"
		enabled "true"
		action "Infinity_PopMenu('BUFFBOT_PARTY_RENAME'); bbPartyName = BfBot.PartyUI.preset.name"
		text lua "BfBot.Plan.Text('Cancel')"
		text style "bb_button"
		bam "GUIOSTUL"
		scaleToClip
		area 0 0 100 28
	}
}


