menu
{
	name "BUFFBOT_PARTY_CHOICES"
	ignoreesc
	onopen "BfBot.PartyUI.PopupLayout(false)"
	text
	{
		name "bpChoicesDismiss"
		action "Infinity_PopMenu('BUFFBOT_PARTY_CHOICES')"
		rectangle 1
		rectangle opacity 130
		on escape
		area 0 0 99999 99999
	}
	label
	{
		name "bpChoicesShadow"
		rectangle 5
		rectangle opacity 160
		area 0 0 100 28
	}
	label
	{
		name "bpChoicesTop"
		rectangle 5
		rectangle opacity 255
		area 0 0 100 28
	}
	label
	{
		name "bpChoicesBottom"
		rectangle 5
		rectangle opacity 255
		area 0 0 100 28
	}
	label
	{
		name "bpChoicesLeft"
		rectangle 5
		rectangle opacity 255
		area 0 0 100 28
	}
	label
	{
		name "bpChoicesRight"
		rectangle 5
		rectangle opacity 255
		area 0 0 100 28
	}
	label
	{
		name "bpChoicesBg"
		mosaic "BFBOTBG"
		area 0 0 100 28
	}
	label
	{
		name "bpChoicesTitle"
		enabled "bbPartyChoiceTitle ~= ''"
		text lua "bbPartyChoiceTitle"
		text style "bb_normal_parchment"
		text color lua "{38,32,26}"
		text align left center
		area 0 0 100 28
	}
	label
	{
		name "bpChoicesHint"
		enabled "bbPartyChoiceHint ~= ''"
		text lua "bbPartyChoiceHint"
		text style "bb_normal_parchment"
		text color lua "{38,32,26}"
		text align left center
		area 0 0 100 28
	}
	list
	{
		column
		{
			width 10
			label
			{
				area 2 2 28 28
				icon lua "bbPartyChoices[rowNumber] and bbPartyChoices[rowNumber].icon or ''"
			}
		}
		column
		{
			width 90
			label
			{
				area 2 0 -1 34
				text lua "bbPartyChoices[rowNumber] and bbPartyChoices[rowNumber].name or ''"
				text style "bb_normal_parchment"
				text color lua "BfBot.PartyUI.choiceMode == 'caster' and bbPartyChoices[rowNumber] and bbPartyChoices[rowNumber].kind == 'info' and {125,120,112} or {38,32,26}"
				text align left center
			}
		}
		name "bpChoices"
		enabled "true"
		table "bbPartyChoices"
		var "bbPartyChoiceSelection"
		action "BfBot.PartyUI.Choose()"
		rowheight 34
		scrollbar "GUISCRC"
		hidehighlight
		area 0 0 900 300
	}
	button
	{
		name "bpChoicesClose"
		enabled "true"
		action "Infinity_PopMenu('BUFFBOT_PARTY_CHOICES')"
		text lua "BfBot.Plan.Text('Close')"
		text style "bb_button"
		bam "GUIOSTUL"
		scaleToClip
		area 0 0 100 28
	}
}
menu
{
	name "BUFFBOT_PARTY_RENAME"
	ignoreesc
	onopen "BfBot.PartyUI.PopupLayout(true)"
	text
	{
		name "bpRenameDismiss"
		action "Infinity_PopMenu('BUFFBOT_PARTY_RENAME'); bbPartyName = BfBot.PartyUI.preset.name"
		rectangle 1
		rectangle opacity 130
		on escape
		area 0 0 99999 99999
	}
	label
	{
		name "bpRenameShadow"
		rectangle 5
